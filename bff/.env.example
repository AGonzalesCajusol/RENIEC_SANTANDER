# ==========================================
# Configuración de Integración RENIEC ID-Perú (BFF)
# ==========================================

# URL Base del servicio IdAAS de RENIEC (Flujo CIBA)
RENIEC_BASE_URL=https://idaas2.reniec.gob.pe

# Credenciales oficiales proporcionadas por RENIEC para Santander
RENIEC_CLIENT_ID=tu_client_id
RENIEC_CLIENT_SECRET=tu_client_secret

# Dominio autorizado registrado ante RENIEC (evita bloqueos WAF)
RENIEC_REFERER=santander.com.pe

# URL pública de este BFF para recibir las notificaciones webhook de RENIEC (Flujo CIBA)
# - En servidor público: http://34.230.11.10/api/auth/notify (o tu dominio HTTPS)
# - En desarrollo local: usar túnel público como ngrok o Cloudflare Tunnel
URL_NOTIFY_ID_PERU=http://localhost:8000/api/auth/notify

# Timeout para solicitudes HTTP a RENIEC en segundos
REQUEST_TIMEOUT=15

# ==========================================
# Base de Datos PostgreSQL (Transacciones CIBA y Sesiones DNI Digital)
# ==========================================
# Formato Python SQLModel/SQLAlchemy (psycopg v3):
# postgresql+psycopg://<USUARIO>:<PASSWORD>@<HOST>:<PUERTO>/<DATABASE>
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5435/reniec_santander_db

# ==========================================
# Módulo de Verificación de DNI Digital (Inji Verify / OpenID4VP - Perú Pass)
# ==========================================
# Opción A (RENIEC Oficial Directo):
VERIFY_SERVICE_INTERNAL_URL=https://verify.inji-reniec.com/v1/verify
VERIFY_SERVICE_PUBLIC_URL=https://verify.inji-reniec.com/v1/verify
VERIFY_CLIENT_ID=did:web:verify.inji-reniec.com:v1:verify
VERIFY_PRESENTATION_DEFINITION_ID=b2c3d4e5-f6a7-8901-bcde-f12345678901

# Opción B (Contenedor verify-service propio en servidor local/on-premise):
# VERIFY_SERVICE_INTERNAL_URL=http://localhost:8081/v1/verify
# VERIFY_SERVICE_PUBLIC_URL=https://tu-dominio-verificador.com/v1/verify
# VERIFY_CLIENT_ID=did:web:tu-dominio-verificador.com:v1:verify
# VERIFY_PRESENTATION_DEFINITION_ID=PERFIL-TITULAR-BASICO

# Tiempo de espera (en segundos) para el polling interno hacia Verify
VERIFY_POLLING_TIMEOUT_SEC=2.0
