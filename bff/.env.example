# ==========================================
# Configuración de Integración RENIEC ID-Perú (BFF)
# ==========================================

# URL Base del servicio IdAAS de RENIEC
RENIEC_BASE_URL=https://idaas2.reniec.gob.pe

# Credenciales oficiales proporcionadas por RENIEC para Santander
RENIEC_CLIENT_ID=tu_client_id
RENIEC_CLIENT_SECRET=tu_client_secret

# Dominio autorizado registrado ante RENIEC (evita bloqueos WAF)
RENIEC_REFERER=santander.com.pe

# URL pública de este BFF para recibir las notificaciones de RENIEC
# (En local usar túnel público como ngrok o Cloudflare Tunnel)
URL_NOTIFY=http://localhost:8000/api/auth/notify

# Timeout para solicitudes HTTP a RENIEC en segundos
REQUEST_TIMEOUT=15

# ==========================================
# Base de Datos PostgreSQL (Transacciones CIBA)
# ==========================================
# Formato Python SQLAlchemy para jdbc:postgresql://localhost:5435/reniec_santander_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5435/reniec_santander_db
